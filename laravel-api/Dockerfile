# laravel-api/Dockerfile
#
# Small companion service ("Research API"). This is OUR code, not OJS —
# see docs/architecture.md for how it relates to the OJS platform.
#
# PREREQUISITE: run scripts/bootstrap-laravel-api.sh once first. This
# repo commits only the application code we wrote; the standard
# Laravel 12 skeleton (bootstrap/app.php, artisan, public/index.php,
# config/*.php) is generated by that script from the real, current
# laravel/laravel package rather than hand-typed into git. Without
# running it first, `composer install` below will succeed but the
# container will have no artisan/public/index.php to actually run.

# --- Stage 1: install PHP dependencies with Composer ---
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock* ./
RUN composer install \
    --no-dev \
    --no-scripts \
    --no-autoloader \
    --ignore-platform-reqs

COPY . .
RUN composer dump-autoload --optimize --no-dev

# --- Stage 2: runtime image ---
FROM php:8.2-apache-bookworm AS runtime

LABEL org.opencontainers.image.title="Research API" \
      org.opencontainers.image.description="Small Laravel service built for this project, independent of OJS core."

# apcu backs the small hand-rolled /api/metrics endpoint (see
# app/Http/Middleware/TrackRequestMetrics.php) — it's the standard way
# to share counters across separate Apache/PHP worker processes,
# since each request is otherwise a fresh PHP process with no shared
# memory of its own.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libzip-dev \
        libpng-dev \
        unzip \
        curl \
        $PHPIZE_DEPS \
    && docker-php-ext-install pdo_mysql zip \
    && pecl install apcu \
    && docker-php-ext-enable apcu \
    && a2enmod rewrite \
    && rm -rf /var/lib/apt/lists/*

RUN { \
      echo "apc.enable_cli=1"; \
      echo "apc.shm_size=32M"; \
    } > /usr/local/etc/php/conf.d/apcu-overrides.ini

WORKDIR /var/www/html
COPY --from=vendor /app /var/www/html

# Laravel serves from /public — point Apache's DocumentRoot there
# instead of the app root, so app/ and .env are never web-accessible.
RUN sed -i 's#/var/www/html#/var/www/html/public#g' /etc/apache2/sites-available/000-default.conf \
    && sed -i 's#/var/www/#/var/www/html/public#g' /etc/apache2/apache2.conf

RUN chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache \
    && chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -f http://localhost/api/health || exit 1

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["apache2-foreground"]
