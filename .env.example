# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=changeme_root_password
OJS_DB_NAME=ojs
OJS_DB_USER=ojs_app_user
OJS_DB_PASSWORD=changeme_app_password

# --- OJS ---
OJS_VERSION=3_5_0-2
OJS_BASE_URL=http://localhost:8080
# Generate with: openssl rand -base64 32
OJS_APP_KEY=changeme_generate_a_random_key

# --- Laravel Research API ---
LARAVEL_APP_URL=http://localhost:8081
