# k8s/mysql-secret.yaml.example
#
# This is a TEMPLATE, not a real Secret. Copy it to mysql-secret.yaml
# (gitignored), fill in real values, and apply it — or better, generate
# it imperatively so nothing sensitive ever touches disk in plaintext:
#
#   kubectl create secret generic mysql-credentials \
#     --namespace research-platform \
#     --from-literal=root-password='<your-root-password>' \
#     --from-literal=db-name=ojs \
#     --from-literal=db-user=ojs_app_user \
#     --from-literal=db-password='<your-app-password>'
#
apiVersion: v1
kind: Secret
metadata:
  name: mysql-credentials
  namespace: research-platform
type: Opaque
stringData:
  root-password: "REPLACE_ME"
  db-name: "ojs"
  db-user: "ojs_app_user"
  db-password: "REPLACE_ME"
