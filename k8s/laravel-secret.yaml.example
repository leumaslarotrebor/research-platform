# k8s/laravel-secret.yaml.example
#
#   kubectl create secret generic laravel-app-secret \
#     --namespace research-platform \
#     --from-literal=app-key="base64:$(openssl rand -base64 32)"
#
apiVersion: v1
kind: Secret
metadata:
  name: laravel-app-secret
  namespace: research-platform
type: Opaque
stringData:
  app-key: "REPLACE_ME"
