# k8s/ojs-secret.yaml.example
#
# Template only — copy to ojs-secret.yaml (gitignored) or generate
# imperatively:
#
#   kubectl create secret generic ojs-app-secret \
#     --namespace research-platform \
#     --from-literal=app-key="$(openssl rand -base64 32)"
#
apiVersion: v1
kind: Secret
metadata:
  name: ojs-app-secret
  namespace: research-platform
type: Opaque
stringData:
  app-key: "REPLACE_ME"
